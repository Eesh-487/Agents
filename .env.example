# Copy to .env and fill in. On Hugging Face these go in Space Settings -> Secrets.

# Neo4j Aura (console.neo4j.io -> instance -> Connect). URI looks like neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=

# Chroma Cloud (trychroma.com -> database -> Connect)
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=

# Optional. Normally the frontend sets the LLM at runtime via PUT /llm/config.
# Set these only for a default that survives restarts. Empty LLM_MODEL = local MLX (Apple Silicon only).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Server deploys only (docker-compose.yml): public hostname Caddy gets an HTTPS
# certificate for, e.g. 140-238-1-2.sslip.io (your VM's IP with dashes).
DOMAIN=

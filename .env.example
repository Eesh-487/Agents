# Copy to .env and fill in. On Hugging Face these go in Space Settings -> Secrets.

# Neo4j Aura (console.neo4j.io -> instance -> Connect). URI looks like neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=

# Chroma Cloud (trychroma.com -> database -> Connect)
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=

# Hosted OpenAI-compatible LLM. Leave LLM_MODEL empty to use local MLX (Apple Silicon only).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=

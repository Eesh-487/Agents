# Copy this file to .env and fill in your real values. .env is gitignored.

# Groq (OpenAI-compatible endpoint)
LLM_API_KEY=your-groq-api-key
LLM_BASE_URL=https://api.groq.com/openai/v1
GENERATOR_MODEL=qwen3.5:9b
DISCRIMINATOR_MODEL=llama-3.3-70b-versatile

# Neo4j (Aura free tier recommended for a deployable prototype)
NEO4J_URI=neo4j+s://your-instance-id.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-aura-generated-password
NEO4J_DATABASE=your-database-name

# Chroma Cloud (free tier - trychroma.com)
CHROMA_API_KEY=your-chroma-cloud-api-key
CHROMA_TENANT=your-chroma-tenant-id
CHROMA_DATABASE=your-chroma-database-name
